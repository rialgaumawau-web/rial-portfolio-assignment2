<!DOCTYPE html>
<html lang="en">
<head>

    <title>Contact Me</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
         rel="stylesheet">

    <link rel="stylesheet" href="/stylesheets/style.css">

</head>

<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

        <a class="navbar-brand" href="/">Rial Portfolio</a>

        <div>
            <a class="nav-link d-inline text-white me-3" href="/">Home</a>
            <a class="nav-link d-inline text-white me-3" href="/about">About</a>
            <a class="nav-link d-inline text-white me-3" href="/projects">Projects</a>
            <a class="nav-link d-inline text-white" href="/contact">Contact</a>
        </div>

    </div>
</nav>

<div class="container mt-5">

    <h1 class="text-center mb-4">
        Contact Me
    </h1>

    <form>

        <div class="mb-3">

            <label class="form-label">
                Name
            </label>

            <input type="text"
                   class="form-control"
                   required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Email
            </label>

            <input type="email"
                   class="form-control"
                   required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Phone Number
            </label>

            <input type="tel"
                   class="form-control"
                   required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Message
            </label>

            <textarea class="form-control"
                      rows="4"
                      required></textarea>

        </div>

        <button class="btn btn-warning">
            Submit
        </button>

    </form>

    <hr>

    <h4>Contact Information</h4>

    <p>Email: rialgaumawau@gmail.com</p>

    <p>Phone: 2493567967</p>

</div>

<footer class="bg-dark text-white text-center p-3 mt-5">

    <p>
        Email: rialgaumawau@gmail.com
    </p>

    <p>
        © 2026 Rial Mawau
    </p>

</footer>

</body>
</html>
